@@ -0,0 +1,16 @@
+#pragma once
+// Debug dump of recursion inputs/outputs for external (GPU) re-implementation checks.
+// Enabled by setting B3D_DUMP=<path prefix>.
+#include "Bigfloat.hxx"
+#include <cstdlib>
+#include <fstream>
+#include <iomanip>
+#include <string>
+
+inline const char *b3d_dump_prefix() { return std::getenv("B3D_DUMP"); }
+
+inline void b3d_set_precision(std::ostream &os)
+{
+  os << std::setprecision(
+    int(boost::multiprecision::mpf_float::default_precision()) + 5);
+}
